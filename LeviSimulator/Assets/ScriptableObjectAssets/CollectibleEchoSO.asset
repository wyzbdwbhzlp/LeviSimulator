  collectibleEchoes:
  - echoID: 1
    echoTitle: "\u795E\u5C71\uFF08\u68A6\u5883\u7248\u672C\uFF09\u200B "
    echoText: "\u767B\u5C71\u65E5\u8BB0\uFF1A\u76AE\u8D28\u5C01\u9762\u88AB\u51B0\u96EA\u6D78\u900F\uFF0C\u67D0\u9875\u7528\u94C5\u7B14\u5199\u7740\uFF1A\u201C\u51FA\u53D1\u524D\u68C0\u67E5\u4E86\u7B2C\u4E03\u4EE3\u78B3\u7EA4\u7EF4\u94A9\u7D22\uFF0C\u627F\u91CD\u6D4B\u8BD5\u8FBE
      300 \u516C\u65A4\uFF0C\u4FDD\u9669\u6263\u6BD4\u4E0A\u6B21\u52A0\u56FA\u4E86
      0.5 \u5398\u7C73\u3002\u6C14\u8C61\u7AD9\u8BF4\u672A\u6765\u4E09\u5929\u65E0\u98CE\uFF0C\u9002\u5408\u51B2\u9876\u3002\u5305\u91CC\u5E26\u4E86\u5988\u5988\u505A\u7684\u725B\u8089\u5E72\uFF0C\u53BB\u5E74\u5728\u4E5E\u529B\u9A6C\u624E\u7F57\u5C71\u65F6\uFF0C\u5C31\u662F\u9760\u8FD9\u4E2A\u6491\u8FC7\u6700\u540E
      800 \u7C73\u3002\u201D \u9875\u9762\u8FB9\u7F18\u753B\u7740\u7B80\u6613\u7684\u767B\u5C71\u8DEF\u7EBF\u56FE\uFF0C\u6807\u6CE8\u7740
      \u201C\u6B64\u5904\u6709\u677E\u52A8\u5CA9\u5757\u201D\u3002 \u200B \u8A93\u8A00\u7EB8\u6761\uFF1A\u4ECE\u65E5\u8BB0\u672C\u91CC\u6389\u51FA\u7684\u5C0F\u7EB8\u7247\uFF0C\u6298\u53E0\u5904\u5DF2\u78E8\u7834\uFF1A\u201C2019
      \u5E74 6 \u6708 18 \u65E5\uFF0C\u5728\u56FD\u5BB6\u8BAD\u7EC3\u4E2D\u5FC3\u7684\u6500\u5CA9\u5899\u4E0B\uFF0C\u6211\u5BF9\u7740\u56FD\u65D7\u53D1\u8A93\uFF1A\u4E00\u5B9A\u8981\u7AD9\u5728\u795E\u5C71\u4E4B\u5DC5\uFF0C\u8BA9\u4E16\u754C\u770B\u5230\u4E2D\u56FD\u9009\u624B\u7684\u94A9\u7D22\u6280\u672F\u3002\u6559\u7EC3\u8BF4\u8FD9\u5EA7\u5C71\u541E\u566C\u8FC7
      73 \u4E2A\u767B\u5C71\u8005\uFF0C\u4F46\u6211\u6478\u8FC7\u5CA9\u58C1\u7684\u77F3\u5934\uFF0C\u5B83\u4EEC\u5728\u7B49\u6211\u5F81\u670D\u3002\u201D
      \u7EB8\u7247\u80CC\u9762\u6709\u4E2A\u5C0F\u5C0F\u7684\u7B11\u8138\u6D82\u9E26\u3002\u200B 
      \u5185\u5FC3\u6050\u60E7\u72EC\u767D\uFF1A\u523B\u5728\u5CA9\u58C1\u7684\u51B0\u9762\u4E0A\uFF0C\u5B57\u8FF9\u968F\u547C\u5438\u7684\u96FE\u6C14\u65F6\u9690\u65F6\u73B0\uFF1A\u201C\u5760\u5D16\u65F6\u770B\u5230\u7684\u96EA\u662F\u9ED1\u8272\u7684\uFF0C\u98CE\u5728\u5632\u7B11\u6211\u2018\u4F60\u770B\uFF0C\u4F60\u8FDE\u81EA\u5DF1\u7684\u624B\u90FD\u63A7\u5236\u4E0D\u4E86\u2019\u3002\u90A3\u4E9B\u5956\u676F\u5728\u68A6\u91CC\u53D8\u6210\u77F3\u5934\u7838\u6211\uFF0C\u8BB0\u8005\u7684\u95EA\u5149\u706F\u6BD4\u5C71\u5D29\u65F6\u7684\u788E\u77F3\u66F4\u523A\u773C\u3002\u4ED6\u4EEC\u8BF4\u2018\u5929\u624D\u9668\u843D\u2019\uFF0C\u53EF\u6211\u53EA\u662F\u6015
      \u2014\u2014 \u6015\u518D\u4E5F\u63E1\u4E0D\u4F4F\u94A9\u7D22\uFF0C\u66F4\u6015\u627F\u8BA4\u81EA\u5DF1\u771F\u7684\u4E0D\u884C\u4E86\u3002\u201D\u200B "
    echoIllustrationsSprite: {fileID: -2108119141, guid: 4570cda63c5ac5e4ba7fe03933d5c065, type: 3}
    echoIllustrationsPath: Assets/Resources/Art/Temp/aa55e13f-8c4b-4ca2-be83-bc30554a6f5c.jpg
  - echoID: 2
    echoTitle: "\u300A\u94A9\u7D22\u8FD0\u52A8\u5468\u520A\u300B\u5934\u7248"
    echoText: "\u5C01\u9762\u662F\u8389\u8389\u5B89\u5728\u51B3\u8D5B\u4E2D\u817E\u7A7A\u7FFB\u8F6C\u7684\u77AC\u95F4\uFF0C\u8FD0\u52A8\u670D\u8863\u89D2\u88AB\u98CE\u6380\u8D77\u5982\u632F\u7FC5\u7684\u8776\u3002\u5185\u6587\u8BE6\u7EC6\u8BB0\u8F7D\u7740\u5979\u4EE5
      1 \u5206 23 \u79D2\u5237\u65B0\u5168\u7403\u57CE\u5E02\u697C\u5B87\u969C\u788D\u8D5B\u7EAA\u5F55\u7684\u58EE\u4E3E\uFF0C\u8BB0\u8005\u7528
      \u201C\u6559\u79D1\u4E66\u7EA7\u7684\u94A9\u7D22\u89D2\u5EA6\u8BA1\u7B97\u201D
      \u5F62\u5BB9\u5979\u5728\u7B2C\u4E03\u4E2A\u8F6C\u89D2\u5904\u7684\u6781\u9650\u64CD\u4F5C\uFF0C\u6587\u672B\u7279\u522B\u6807\u6CE8
      \u201C\u8FD9\u662F\u5979\u804C\u4E1A\u751F\u6DAF\u7B2C 17 \u5EA7\u56FD\u9645\u8D5B\u4E8B\u5956\u676F\u201D"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 3
    echoTitle: "\u7C89\u4E1D\u6765\u4FE1"
    echoText: "\u4FE1\u5C01\u4E0A\u8D34\u7740\u7528\u5F69\u7EF3\u7F16\u7684\u8FF7\u4F60\u94A9\u7D22\u6A21\u578B\uFF0C\u4FE1\u7EB8\u4E0A\u662F\u7A1A\u5AE9\u7684\u5B57\u8FF9\uFF1A\u201C\u4E0A\u5468\u5728\u829D\u52A0\u54E5\u73B0\u573A\u770B\u4E86\u4F60\u6BD4\u8D5B\uFF0C\u4F60\u4ECE\u4F1A\u5C55\u4E2D\u5FC3\u697C\u9876\u8DC3\u51FA\u65F6\uFF0C\u9633\u5149\u521A\u597D\u7167\u5728\u4F60\u62A4\u76EE\u955C\u4E0A\uFF0C\u50CF\u6709\u661F\u661F\u843D\u5728\u4E0A\u9762\u3002\u6211\u628A\u4F60\u7684\u7167\u7247\u8D34\u5728\u6ED1\u677F\u4E0A\uFF0C\u73B0\u5728\u6BCF\u6B21\u7EC3\u4E60\u90FD\u89C9\u5F97\u5145\u6EE1\u529B\u6C14
      \u2014\u2014 \u6765\u81EA 12 \u5C81\u7684\u672C\u3002\u201D\u200B\n"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 4
    echoTitle: "\u56FD\u9645\u94A9\u7D22\u6311\u6218\u8D5B\u9080\u8BF7\u51FD"
    echoText: "\u70EB\u91D1\u7684\u4FE1\u5C01\u8FB9\u7F18\u5370\u7740\u8D5B\u4E8B
      logo\uFF0C\u5185\u9875\u7528\u938F\u91D1\u5B57\u4F53\u5199\u7740\uFF1A\u201C\u7279\u9080\u8389\u8389\u5B89\u9009\u624B\u4F5C\u4E3A\u672C\u5C4A\u8D5B\u4E8B\u63ED\u5E55\u6218\u8868\u6F14\u8005\uFF0C\u7EC4\u59D4\u4F1A\u5DF2\u4E3A\u60A8\u51C6\u5907\u4E13\u5C5E\u8BAD\u7EC3\u7A7A\u57DF\uFF0C\u5305\u542B\u6A21\u62DF\u795E\u5C71\u5357\u6BB5\u5730\u5F62\u7684\u7279\u6B8A\u969C\u788D\u533A\uFF0C\u671F\u5F85\u60A8\u7684\u6807\u5FD7\u6027\u2018\u9E70\u96BC\u4FEF\u51B2\u2019\u52A8\u4F5C\u518D\u6B21\u9707\u64BC\u4E16\u754C\u3002\u201D\u200B\n"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 5
    echoTitle: "\u75C5\u5386\u5355"
    echoText: "\u7EB8\u5F20\u8FB9\u7F18\u56E0\u53CD\u590D\u7FFB\u9605\u800C\u5377\u89D2\uFF0C\u8BCA\u65AD\u7ED3\u679C\u680F\u7528\u7EA2\u7B14\u6807\u6CE8\uFF1A\u201C\u53CC\u624B\u5C3A\u795E\u7ECF\u65AD\u88C2\uFF0C\u808C\u8171\u4E25\u91CD\u6495\u88C2\uFF0C\u672F\u540E\u808C\u529B\u6062\u590D\u81F3
      3 \u7EA7\u4EE5\u4E0B\uFF0C\u7CBE\u7EC6\u52A8\u4F5C\u529F\u80FD\u6C38\u4E45\u6027\u635F\u4F24\u3002\u201D
      \u4E0B\u65B9\u9644\u7740\u5EB7\u590D\u5E08\u7684\u624B\u5199\u5907\u6CE8\uFF1A\u201C\u60A3\u8005\u4ECA\u65E5\u5C1D\u8BD5\u63E1\u7B14\u65F6\u51FA\u73B0\u5267\u70C8\u98A4\u6296\uFF0C\u60C5\u7EEA\u6FC0\u52A8\u540E\u6307\u5C16\u53D1\u7D2B\uFF0C\u5EFA\u8BAE\u6682\u505C\u9AD8\u5F3A\u5EA6\u590D\u5065\u8BAD\u7EC3\u3002\u201D\u200B\n"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 6
    echoTitle: "\u62A4\u58EB\u503C\u73ED\u8BB0\u5F55"
    echoText: "\u84DD\u8272\u5706\u73E0\u7B14\u5B57\u8FF9\u7565\u663E\u6F66\u8349\uFF1A\u201C03:17\uFF0C307
      \u5E8A\u60A3\u8005\u7A81\u53D1\u5453\u8BED\uFF0C\u53CD\u590D\u547C\u558A\u2018\u5DE6\u94A9\u7D22\u677E\u4E86\u2019\uFF0C\u4F34\u968F\u53CC\u624B\u62BD\u6410\u300204:22\uFF0C\u89C2\u5BDF\u5230\u60A3\u8005\u773C\u89D2\u6709\u6CEA\u6DB2\u6E17\u51FA\uFF0C\u76D1\u62A4\u4EEA\u663E\u793A\u5FC3\u7387\u9AA4\u5347\u81F3
      120 \u6B21 / \u5206\u300206:00\uFF0C\u624B\u6307\u8F7B\u5FAE\u8737\u7F29\uFF0C\u4F3C\u5728\u6293\u53D6\u7A7A\u4E2D\u7684\u4EC0\u4E48\u3002\u201D\u200B\n"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 7
    echoTitle: "\u5F55\u97F3\u7B14"
    echoText: "\u201C\u2026\u2026 \u6559\u7EC3\u8BF4\u6211\u80FD\u884C\u7684\u2026\u2026
      \u90A3\u6839\u5CA9\u9489\u660E\u660E\u662F\u7A33\u56FA\u7684\u2026\u2026 \u4E3A\u4EC0\u4E48\u6293\u4E0D\u4F4F\u2026\u2026
      \u624B\u597D\u75BC\u2026\u2026 \u5988\uFF0C\u522B\u5173\u6389\u8BAD\u7EC3\u5BA4\u7684\u706F\u2026\u2026\u201D\u200B\n"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 8
    echoTitle: "\u533F\u540D\u7F51\u53CB\u8BC4\u8BBA"
    echoText: "\u622A\u56FE\u6765\u81EA\u67D0\u4F53\u80B2\u8BBA\u575B\u7684\u70ED\u95E8\u5E16\uFF0C\u7070\u8272\u5934\u50CF\u4E0B\u7684\u6587\u5B57\u7528\u523A\u773C\u7684\u7EA2\u8272\u9AD8\u4EAE\uFF1A\u201C\u65E9\u5C31\u770B\u5979\u4E0D\u987A\u773C\uFF0C\u6BCF\u6B21\u91C7\u8BBF\u90FD\u88C5\u6E05\u9AD8\uFF0C\u6454\u6B7B\u4E5F\u662F\u6D3B\u8BE5\uFF01\u4E0A\u6B21\u8D5B\u4E8B\u80AF\u5B9A\u4E70\u901A\u4E86\u88C1\u5224\uFF0C\u4E0D\u7136\u600E\u4E48\u53EF\u80FD\u8D62\u8FC7\u8428\u62C9\uFF1F\u73B0\u5728\u62A5\u5E94\u6765\u4E86\uFF0C\u6B8B\u5965\u4F1A\u90FD\u4E0D\u6536\u5979\u8FD9\u79CD\u5E9F\u4EBA\uFF01\u201D
      \u8BC4\u8BBA\u4E0B\u6709 237 \u4E2A\u70B9\u8D5E\uFF0C\u5939\u6742\u7740 \u201C\u8BF4\u5F97\u5BF9\u201D\u201C\u8D76\u7D27\u9000\u5F79\u5427\u201D
      \u7684\u9644\u548C\u3002"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 9
    echoTitle: "\u67D0\u5A92\u4F53\u62A5\u9053"
    echoText: "\u6807\u9898\u7528\u52A0\u7C97\u9ED1\u5B57\u5199\u7740 \u201C\u72EC\u5BB6\u63ED\u79D8\uFF1A\u51A0\u519B\u9668\u843D\u80CC\u540E\u7684\u8BAD\u7EC3\u9ED1\u5E55\u201D\uFF0C\u6B63\u6587\u5F15\u7528
      \u201C\u533F\u540D\u6559\u7EC3\u201D \u7684\u8BDD\u79F0\u8389\u8389\u5B89 \u201C\u957F\u671F\u4F7F\u7528\u8FDD\u7981\u5174\u594B\u5242\u589E\u5F3A\u7206\u53D1\u529B\u201D\uFF0C\u914D\u7684\u7167\u7247\u662F\u5979\u5760\u5D16\u65F6\u6A21\u7CCA\u7684\u80CC\u5F71\uFF0C\u89D2\u843D\u7528\u5C0F\u5B57\u6807\u6CE8
      \u201C\u56FE\u7247\u6765\u6E90\u7F51\u7EDC\uFF0C\u4FB5\u5220\u201D\u3002\u6587\u672B\u9644\u5E26\u6295\u7968\u6846\uFF1A\u201C\u4F60\u8BA4\u4E3A\u5979\u8FD8\u80FD\u590D\u51FA\u5417\uFF1F\u201D78%
      \u7684\u9009\u9879\u662F \u201C\u7EDD\u65E0\u53EF\u80FD\u201D\u3002\u200B\n"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 10
    echoTitle: "\u670B\u53CB\u53D1\u6765\u7684\u6D88\u606F"
    echoText: "\u7EFF\u8272\u6C14\u6CE1\u5728\u5C4F\u5E55\u4E0A\u5FAE\u5FAE\u98A4\u52A8\uFF1A\u201C\u4ECA\u5929\u53BB\u5668\u6750\u5E97\u7ED9\u4F60\u4E70\u4E86\u65B0\u7684\u63E1\u529B\u7403\uFF0C\u662F\u4F60\u6700\u559C\u6B22\u7684\u5929\u84DD\u8272\uFF0C\u5E26\u6309\u6469\u9897\u7C92\u7684\u90A3\u79CD\u3002\u62A4\u5DE5\u8BF4\u4F60\u4ECA\u5929\u7741\u5F00\u8FC7\u773C\u775B\uFF0C\u867D\u7136\u53EA\u6709\u51E0\u79D2\u3002\u6211\u628A\u4F60\u8D62\u7684\u7B2C\u4E00\u5EA7\u5956\u676F\u6446\u5728\u5E8A\u5934\u67DC\u4E0A\u4E86\uFF0C\u5E95\u5EA7\u7684\u2018\u6C38\u4E0D\u8A00\u5F03\u2019\u770B\u5F97\u5F88\u6E05\u695A\uFF0C\u7B49\u4F60\u9192\u8FC7\u6765\u4E00\u8D77\u64E6\u7070\u554A\u3002\u201D\u200B\n"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 11
    echoTitle: "\u7834\u788E\u5956\u676F\u788E\u7247"
    echoText: "\u201C\u8389\u8389\u5B89\uFF0C2023 \u5E74\u5EA6\u6700\u4F73\u9009\u624B\u201D\uFF0C\u65AD\u88C2\u5904\u80FD\u770B\u5230\u91CC\u9762\u7684\u9EC4\u94DC\u5939\u5C42\u3002\u788E\u7247\u80CC\u9762\u7C98\u7740\u534A\u5F20\u9881\u5956\u665A\u5BB4\u7684\u95E8\u7968\uFF0C\u65E5\u671F\u662F\u5979
      22 \u5C81\u751F\u65E5\u90A3\u5929\u3002"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 12
    echoTitle: "\u65E7\u7167\u7247\u6B8B\u7247"
    echoText: "\u8FB9\u7F18\u88AB\u6C34\u6D78\u6CE1\u5F97\u53D1\u76B1\uFF0C\u80FD\u770B\u6E05\u5979\u548C\u961F\u53CB\u4EEC\u7AD9\u5728\u96EA\u5C71\u9876\u5CF0\uFF0C\u6BCF\u4E2A\u4EBA\u9F3B\u5C16\u90FD\u51BB\u5F97\u901A\u7EA2\u3002\u5979\u624B\u91CC\u4E3E\u7740\u7684\u961F\u65D7\u7F3A\u4E86\u4E00\u89D2\uFF0C\u4E0A\u9762\u7EE3\u7740\u7684
      \u201C\u730E\u9E70\u5C0F\u961F\u201D \u5B57\u6837\u4F9D\u7A00\u53EF\u8FA8\u3002\u7167\u7247\u80CC\u9762\u7528\u94A2\u7B14\u5199\u7740\uFF1A\u201C2022.12.25\uFF0C\u5B8C\u6210\u963F\u5C14\u5351\u65AF\u5C71\u8109\u7A7F\u8D8A\u6311\u6218\uFF0C\u4ECA\u5E74\u5723\u8BDE\u793C\u7269\u662F\u6C38\u4E0D\u7ED3\u51B0\u7684\u94A9\u7D22\u6ED1\u8F6E\u3002\u201D\u200B\n"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 13
    echoTitle: "\u5BF9\u624B\u7684\u7559\u8A00\u6761"
    echoText: "\u5199\u5728\u8D5B\u4E8B\u4E13\u7528\u4FBF\u7B7E\u7EB8\u4E0A\uFF0C\u5B57\u8FF9\u9052\u52B2\u6709\u529B\uFF1A\u201C\u770B\u5230\u65B0\u95FB\u65F6\u6B63\u5728\u6536\u62FE\u88C5\u5907\uFF0C\u60F3\u8D77\u53BB\u5E74\u51B3\u8D5B\u4F60\u5E2E\u6211\u6361\u8D77\u8131\u843D\u7684\u62A4\u8155\u3002\u4ED6\u4EEC\u90FD\u8BF4\u6211\u8BE5\u5E86\u5E78\u5C11\u4E86\u4E2A\u52B2\u654C\uFF0C\u4F46\u8BAD\u7EC3\u65F6\u603B\u5FCD\u4E0D\u4F4F\u770B\u4F60\u5E38\u7AD9\u7684\u90A3\u4E2A\u8D77\u8DF3\u70B9\u3002\u4F60\u7684\u2018\u98DE\u71D5\u8F6C\u8EAB\u2019\u6211\u7EC3\u4E86\u4E09\u4E2A\u6708\uFF0C\u59CB\u7EC8\u5DEE\u7740\u4E00\u53E3\u6C14
      \u2014\u2014 \u8428\u62C9\u7559\u3002\u201D \u4FBF\u7B7E\u89D2\u843D\u753B\u7740\u4E2A\u7B80\u5355\u7684\u94A9\u7D22\u56FE\u6848\u3002\u200B\n"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 14
    echoTitle: "\u767B\u5C71\u65E5\u8BB0"
    echoText: "\u76AE\u8D28\u5C01\u9762\u88AB\u51B0\u96EA\u6D78\u900F\uFF0C\u67D0\u9875\u7528\u94C5\u7B14\u5199\u7740\uFF1A\u201C\u51FA\u53D1\u524D\u68C0\u67E5\u4E86\u7B2C\u4E03\u4EE3\u78B3\u7EA4\u7EF4\u94A9\u7D22\uFF0C\u627F\u91CD\u6D4B\u8BD5\u8FBE
      300 \u516C\u65A4\uFF0C\u4FDD\u9669\u6263\u6BD4\u4E0A\u6B21\u52A0\u56FA\u4E86
      0.5 \u5398\u7C73\u3002\u6C14\u8C61\u7AD9\u8BF4\u672A\u6765\u4E09\u5929\u65E0\u98CE\uFF0C\u9002\u5408\u51B2\u9876\u3002\u5305\u91CC\u5E26\u4E86\u5988\u5988\u505A\u7684\u725B\u8089\u5E72\uFF0C\u53BB\u5E74\u5728\u4E5E\u529B\u9A6C\u624E\u7F57\u5C71\u65F6\uFF0C\u5C31\u662F\u9760\u8FD9\u4E2A\u6491\u8FC7\u6700\u540E
      800 \u7C73\u3002\u201D \u9875\u9762\u8FB9\u7F18\u753B\u7740\u7B80\u6613\u7684\u767B\u5C71\u8DEF\u7EBF\u56FE\uFF0C\u6807\u6CE8\u7740
      \u201C\u6B64\u5904\u6709\u677E\u52A8\u5CA9\u5757\u201D\u3002\n"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 15
    echoTitle: "\u8A93\u8A00\u7EB8\u6761"
    echoText: "\u4ECE\u65E5\u8BB0\u672C\u91CC\u6389\u51FA\u7684\u5C0F\u7EB8\u7247\uFF0C\u6298\u53E0\u5904\u5DF2\u78E8\u7834\uFF1A\u201C2019
      \u5E74 6 \u6708 18 \u65E5\uFF0C\u5728\u56FD\u5BB6\u8BAD\u7EC3\u4E2D\u5FC3\u7684\u6500\u5CA9\u5899\u4E0B\uFF0C\u6211\u5BF9\u7740\u56FD\u65D7\u53D1\u8A93\uFF1A\u4E00\u5B9A\u8981\u7AD9\u5728\u795E\u5C71\u4E4B\u5DC5\uFF0C\u8BA9\u4E16\u754C\u770B\u5230\u4E2D\u56FD\u9009\u624B\u7684\u94A9\u7D22\u6280\u672F\u3002\u6559\u7EC3\u8BF4\u8FD9\u5EA7\u5C71\u541E\u566C\u8FC7
      73 \u4E2A\u767B\u5C71\u8005\uFF0C\u4F46\u6211\u6478\u8FC7\u5CA9\u58C1\u7684\u77F3\u5934\uFF0C\u5B83\u4EEC\u5728\u7B49\u6211\u5F81\u670D\u3002\u201D
      \u7EB8\u7247\u80CC\u9762\u6709\u4E2A\u5C0F\u5C0F\u7684\u7B11\u8138\u6D82\u9E26\u3002\u200B\n"
    echoIllustrationsSprite: {fileID: 0}
    echoIllustrationsPath: 
  - echoID: 16
    echoTitle: "\u5185\u5FC3\u6050\u60E7\u72EC\u767D"
    echoText: "\u523B\u5728\u5CA9\u58C1\u7684\u51B0\u9762\u4E0A\uFF0C\u5B57\u8FF9\u968F\u547C\u5438\u7684\u96FE\u6C14\u65F6\u9690\u65F6\u73B0\uFF1A\u201C\u5760\u5D16\u65F6\u770B\u5230\u7684\u96EA\u662F\u9ED1\u8272\u7684\uFF0C\u98CE\u5728\u5632\u7B11\u6211\u2018\u4F60\u770B\uFF0C\u4F60\u8FDE\u81EA\u5DF1\u7684\u624B\u90FD\u63A7\u5236\u4E0D\u4E86\u2019\u3002\u90A3\u4E9B\u5956\u676F\u5728\u68A6\u91CC\u53D8\u6210\u77F3\u5934\u7838\u6211\uFF0C\u8BB0\u8005\u7684\u95EA\u5149\u706F\u6BD4\u5C71\u5D29\u65F6\u7684\u788E\u77F3\u66F4\u523A\u773C\u3002\u4ED6\u4EEC\u8BF4\u2018\u5929\u624D\u9668\u843D\u2019\uFF0C\u53EF\u6211\u53EA\u662F\u6015
      \u2014\u2014 \u6015\u518D\u4E5F\u63E1\u4E0D\u4F4F\u94A9\u7D22\uFF0C\u66F4\u6015\u627F\u8BA4\u81EA\u5DF1\u771F\u7684\u4E0D\u884C\u4E86\u3002\u201D\u200B\n"
    echoIllustrationsSprite: {fileID: 0}
